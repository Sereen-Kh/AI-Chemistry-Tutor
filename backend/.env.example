# =============================================================================
# EduMind Backend — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- AI / Gemini -------------------------------------------------
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash
AI_REQUEST_TIMEOUT_SECONDS=12
GEMINI_TUTOR_GENERATION_ENABLED=true
GEMINI_TUTOR_TIMEOUT_SECONDS=8
GEMINI_TUTOR_RETRY_ATTEMPTS=1
GEMINI_FAILURE_COOLDOWN_SECONDS=300
GEMINI_DOCUMENT_MODEL=gemini-3.5-flash
# Comma-separated fallbacks are tried in order.
GEMINI_DOCUMENT_FALLBACK_MODEL=gemini-2.5-pro,gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_RERANKER_MODEL=gemini-2.0-flash
GEMINI_SEMANTIC_HELPERS_ENABLED=false
GEMINI_SEMANTIC_HELPER_TIMEOUT_SECONDS=6
GEMINI_SEMANTIC_HELPER_RETRY_ATTEMPTS=1
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
GEMINI_MIN_PAGE_CHARS=40
GEMINI_MIN_COMPLETENESS_SCORE=0.5
PDF_DIRECT_EXTRACTION_ENABLED=true
PDF_IMAGE_FALLBACK_ENABLED=true
ALLOW_HASH_EMBEDDINGS=false
ALLOW_LOCAL_EMBEDDINGS=false
EMBEDDING_PROVIDER=gemini
RAG_QUERY_LOGGING_ENABLED=true
# --- Database ----------------------------------------------------
# For local dev with SQLite (default):
DATABASE_URL=sqlite:///./chemistry_tutor.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./chemistry_tutor.db
# For Docker / production with PostgreSQL (docker-compose overrides these):
# DATABASE_URL=postgresql://edumind:edumind@localhost:5432/edumind
# ASYNC_DATABASE_URL=postgresql+asyncpg://edumind:edumind@localhost:5432/edumind

# --- Auth / Security ---------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_TOKEN=
ADMIN_EMAILS=[]

# --- Redis -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Celery Background Workers -----------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Ingestion Pipeline ------------------------------------------
# OCR_PROVIDER choices: gemini (only supported provider in MVP)
OCR_PROVIDER=gemini
OCR_REQUIRED_FOR_VISION=true
ALLOW_PARTIAL_INGESTION=false
# INGESTION_MODE choices:
#   dry_run    - debugging/Swagger smoke tests; may warn if Gemini is missing and never marks skipped vision as completed
#   production - real ingestion; requires Gemini and all required pages must process successfully
INGESTION_MODE=production

# --- CORS --------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# --- App ---------------------------------------------------------
DEBUG=false

AUDIO_ENABLED=true
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=your_voice_id_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

AUDIO_MAX_DURATION_SECONDS=90
AUDIO_MAX_FILE_SIZE_MB=10
ALLOWED_AUDIO_MIME_TYPES=["audio/webm","audio/mpeg","audio/mp3","audio/wav","audio/x-wav","audio/mp4","audio/m4a","audio/x-m4a"]
AUDIO_STORAGE_DIR=data/uploads/audio
AUDIO_PUBLIC_BASE_URL=/media/uploads
TTS_MAX_CHARS_PER_RESPONSE=1200
